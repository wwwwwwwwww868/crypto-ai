{
  "name": "solana-copy-trader",
  "version": "0.1.0",
  "private": true,
  "description": "Filtered copy-trading bot that mirrors a target Solana wallet's swaps via Jupiter.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx src/index.ts",
    "preflight": "tsx src/scripts/preflight.ts",
    "new-wallet": "tsx src/scripts/newWallet.ts",
    "prepaid-phones": "tsx src/scripts/prepaidPhones.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.4",
    "bip39": "^3.1.0",
    "bs58": "^6.0.0",
    "dotenv": "^16.4.5",
    "ed25519-hd-key": "^1.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
