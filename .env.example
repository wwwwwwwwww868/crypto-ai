# ─────────────────────────────────────────────────────────────
#  RPC — you need a real provider. Public endpoints are rate
#  limited and will cause you to miss trades.
#  Helius / Triton / QuickNode all work.
# ─────────────────────────────────────────────────────────────
RPC_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

# ─────────────────────────────────────────────────────────────
#  The wallet you are copying (public address — read only)
# ─────────────────────────────────────────────────────────────
TARGET_WALLET=

# ─────────────────────────────────────────────────────────────
#  YOUR TRADING WALLET
#
#  Use a FRESH wallet created only for this bot. Run:
#      npm run new-wallet
#  and fund it from Trust Wallet with an amount you accept
#  losing entirely. Do NOT paste your main Trust Wallet seed
#  phrase here — anything in this file can sign away every
#  token that wallet holds.
#
#  Provide EITHER a base58 secret key, OR a mnemonic.
# ─────────────────────────────────────────────────────────────
WALLET_PRIVATE_KEY=
# WALLET_MNEMONIC=
# WALLET_DERIVATION_PATH=m/44'/501'/0'/0'

# ─────────────────────────────────────────────────────────────
#  Execution
# ─────────────────────────────────────────────────────────────
# false => sign and broadcast real transactions.
# true  => run the full pipeline but stop before broadcasting.
DRY_RUN=false

# How to size a copied buy:
#   fixed        => always COPY_FIXED_SOL per trade
#   proportional => same % of your balance as the target spent of theirs
COPY_MODE=fixed
COPY_FIXED_SOL=0.05
COPY_RATIO=1.0

# Jupiter swap API. Free tier is lite-api; paid keys use api.jup.ag.
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1

SLIPPAGE_BPS=150
PRIORITY_FEE_MICROLAMPORTS=200000
MAX_PRIORITY_FEE_SOL=0.002
CONFIRM_TIMEOUT_MS=45000

# ─────────────────────────────────────────────────────────────
#  Risk limits — these are what stand between a bug and an
#  empty wallet. Raise them deliberately, not casually.
# ─────────────────────────────────────────────────────────────
MAX_TRADE_SOL=0.1
DAILY_SPEND_LIMIT_SOL=1.0
DAILY_LOSS_LIMIT_SOL=0.5
MAX_OPEN_POSITIONS=5
MIN_SOL_RESERVE=0.03
MINT_COOLDOWN_MS=60000

# ─────────────────────────────────────────────────────────────
#  Filters — "copy this person, but not their bad trades"
# ─────────────────────────────────────────────────────────────
MAX_PRICE_IMPACT_BPS=300
MIN_TARGET_BUY_SOL=0.05
MAX_TOP10_HOLDER_PCT=70
REQUIRE_NULL_MINT_AUTHORITY=true
REQUIRE_NULL_FREEZE_AUTHORITY=true
REQUIRE_EXIT_ROUTE=true
BLOCKLIST_MINTS=

# Mirror the target's sells as well as their buys
MIRROR_EXITS=true

LOG_LEVEL=info
STATE_FILE=./data/state.json
